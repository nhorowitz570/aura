# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxx

# Public site URL — used by Supabase OAuth callbacks.
# Set this to your Vercel deployment URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OpenRouter (for the assistant)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
