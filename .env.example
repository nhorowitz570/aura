# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxx
# Service role key — required for "Delete account" and other admin ops.
# Server-only; never expose to the client. Get it from Supabase → Project Settings → API.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public site URL — used by Supabase OAuth callbacks.
# Set this to your Vercel deployment URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OpenRouter (for the assistant)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
